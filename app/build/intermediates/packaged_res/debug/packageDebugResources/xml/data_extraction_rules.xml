<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Krishi Saathi (API 31+).
   Excludes device-bound EncryptedSharedPreferences used for authentication tokens
   from both cloud backups and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="krishi_saathi_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="krishi_saathi_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
