<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Krishi Saathi (API 31+).
   Excludes local databases containing farmer registration details, DataStore preferences,
   and cached offline media from cloud backups and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="bakaiya_krishi_saathi_database" />
        <exclude domain="database" path="bakaiya_krishi_saathi_database-shm" />
        <exclude domain="database" path="bakaiya_krishi_saathi_database-wal" />
        <exclude domain="file" path="datastore/bakaiya_krishi_saathi_prefs.preferences_pb" />
        <exclude domain="file" path="authorized_videos" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="bakaiya_krishi_saathi_database" />
        <exclude domain="database" path="bakaiya_krishi_saathi_database-shm" />
        <exclude domain="database" path="bakaiya_krishi_saathi_database-wal" />
        <exclude domain="file" path="datastore/bakaiya_krishi_saathi_prefs.preferences_pb" />
        <exclude domain="file" path="authorized_videos" />
    </device-transfer>
</data-extraction-rules>
